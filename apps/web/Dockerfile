# ── Stage 1: Install dependencies ─────────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

# Copy workspace manifests so npm can resolve all workspaces
COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/contracts/package.json ./packages/contracts/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/

RUN npm install

# ── Stage 2: Build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

ENV NEXT_TELEMETRY_DISABLED=1

# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, not
# read at runtime — they must be passed in as Docker build args. Render
# auto-forwards a Docker-runtime service's envVars as --build-arg values
# matched by name, so these are set as regular envVars in render.yaml.
ARG NEXT_PUBLIC_API_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_HARDHAT_CHAIN_ID
ENV NEXT_PUBLIC_HARDHAT_CHAIN_ID=$NEXT_PUBLIC_HARDHAT_CHAIN_ID
ARG NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID
ENV NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID=$NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_ID

# Bring in installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/packages/shared/node_modules* ./packages/shared/

# Copy all source needed for the build
COPY package.json ./
COPY packages/shared/ ./packages/shared/
COPY apps/web/ ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/contracts/package.json ./packages/contracts/

# Build shared package (web depends on @title-chain/shared)
RUN cd packages/shared && npm run build

# Build Next.js app (output: 'standalone' must be set in next.config.js)
RUN cd apps/web && npm run build

# ── Stage 3: Production runner ─────────────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# The standalone output mirrors the monorepo directory structure.
# server.js lives at <standalone-root>/apps/web/server.js when built from
# the monorepo root context.
COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static

USER node

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by Next.js inside the standalone output at the app's
# workspace path relative to the monorepo root.
CMD ["node", "apps/web/server.js"]
